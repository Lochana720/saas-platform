NODE_ENV=development
PORT=4000
# Runtime: restricted role, subject to Row-Level Security
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/saas
# Migrations + seed: database owner
MIGRATION_DATABASE_URL=postgresql://saas_owner:owner_password@localhost:5432/saas
JWT_ACCESS_SECRET=dev-only-secret-change-me-in-production-0123456789
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
